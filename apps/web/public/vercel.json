{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://konvertt-engine.thegacs.in/api/:path*" },
    { "source": "/u/:path*", "destination": "https://konvertt-upload.thegacs.in/u/:path*" },
    { "source": "/((?!api/|u/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
